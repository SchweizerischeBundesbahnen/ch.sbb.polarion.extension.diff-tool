{
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@sbb-polarion/react-sbb-polarion": "^2.0.1",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "date-fns": "^4.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-istanbul": "4.1.10",
    "cross-spawn": "7.0.6",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vitest-browser-react": "2.2.0"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=11"
  },
  "name": "objects-diff",
  "type": "module",
  "overrides": {
    "postcss": ">=8.5.10"
  },
  "packageManager": "npm@12.0.2",
  "private": true,
  "scripts": {
    "build": "vite build && vite build --config vite.formext.config.js",
    "dev": "vite",
    "dev:e2e": "vite --mode e2e",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "node -e \"process.platform==='linux'||(console.error('\\n[test:update] Reference screenshots must be generated on Linux (inside the pinned Playwright Docker image). Use npm run test:update:docker.\\n'),process.exit(1))\" && vitest run --update",
    "test:docker": "node scripts/docker-test.mjs test",
    "test:update:docker": "node scripts/docker-test.mjs test:update",
    "test:coverage": "vitest run --coverage --exclude \"**/*.visual.test.tsx\"",
    "test:coverage:full": "vitest run --coverage",
    "test:coverage:docker": "node scripts/docker-test.mjs test:coverage:full",
    "format": "prettier --write \"**/*.{ts,tsx,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,html}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "e2e": "npx playwright test",
    "e2e:headless": "npx playwright test --reporter=list"
  },
  "version": "2.1.0",
  "allowScripts": {
    "esbuild": true,
    "fsevents@2.3.2": true,
    "unrs-resolver@1.12.2": true
  }
}
