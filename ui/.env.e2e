# Committed on purpose: the Playwright suite runs `vite --mode e2e`, which loads this file and NOT a
# developer's .env.development.local. Both values are deliberately empty so the suite always exercises
# the session-authenticated /rest/internal base (never /rest/api with a bearer token), regardless of
# what the developer has configured locally.
VITE_BASE_URL=
VITE_BEARER_TOKEN=
