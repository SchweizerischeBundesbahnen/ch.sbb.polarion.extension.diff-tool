# To run the React application locally against a real Polarion, create ".env.development.local" next
# to this file, copy the two lines below into it and fill in your Polarion user token.
#
# VITE_BASE_URL is only the vite dev-server proxy target (see vite.config.js) - the app itself always
# issues same-origin requests. With VITE_BEARER_TOKEN set, useRemote targets the token-authenticated
# /rest/api endpoints instead of the session-authenticated /rest/internal ones.
VITE_BASE_URL=http://localhost
VITE_BEARER_TOKEN=<YOUR_POLARION_USER_TOKEN_HERE>
